	(text "BIAS is in the same position as SVSS. Refer to in manual as BIAS. \nADD POTENTIOMETER \n\n"
		(exclude_from_sim no)
		(at 261.874 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7d228a08-ef9e-40a9-8861-f058c9be4a46")
	)
	(text "Connect to a USB-C power bank. Will provide power to the entire RX circuit.\nCC1, CC2 have a pull down resistor to GND to signify it is an Upstream Facing Port (UFP)\nhttps://medium.com/@leung.benson/usb-type-c-s-configuration-channel-31e08047677d"
		(exclude_from_sim no)
		(at 62.992 70.866 0)
		(effects
			(font
				(face "KiCad Font")
				(size 1.27 1.27)
			)
		)
		(uuid "8d129e0e-4e39-4936-b5fa-c7d4cdb87a94")
	)
	(text "FLT Low = Normal Latency. FLT High = Low Latency. \nXSMT Low = Muted. XSMT High = Unmuted.\nDEMP Low = No De-emphasis eq processing for 44.1kHz.  High = De-emphasis eq.\nFMT Low = I2S Format. FMT High = Left justified.\nUse PLL functional diagram"
		(exclude_from_sim no)
		(at 68.834 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f2a012c9-58a9-4593-ae26-e56923b9807d")
	)
	(text "Adding mute safety switch on XSMT. Also adding a switch on FLT to toggle hi-fi interpolation or low latency. "
		(exclude_from_sim no)
		(at 67.818 209.804 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f5560f9a-26ea-4bf6-a90a-3bf115b63eb3")
	)
