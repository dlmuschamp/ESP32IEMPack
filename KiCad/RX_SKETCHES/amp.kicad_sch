		)
		(uuid "109012d5-58ca-40e1-9815-604a733393d0")
	)
	(text "SHDN_SIGNAL LOW acts as setting the volume to a \"true 0%\" \nby shutting off the IEM amp.\n\nThis is in contrast to the DAC Soft mute which acts as a \nmute toggle without \nchanging the volume. \n\nAmp follows the pseudo-differential input configuration \nbecause the DAC output is a single-ended input.\n"
		(exclude_from_sim no)
		(at 19.558 118.872 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f4ff9b3b-8b1d-403a-ba55-a8ae63f18698")
	)
