	)
	(text "DEMP Low = DISABLE De-emphasis eq (44.1kHz).  \n	 High = ENABLE  De-emphasis eq (44.1kHz).\n\nFMT Low = I2S Format. \n	High = Left justified."
		(exclude_from_sim no)
