		(rev "1.0.0")
		(company "damian m")
		(comment 1 "Data: TX -> RX -> DAC -> AMP-> 3.5mm Jack.")
		(comment 2 "DAC_OUT uses the PCM5102 470R + 2.2nF filter (on the DAC sheet), then the dual-gang pot. ")
		(comment 3 "Volume Knob with integrated off switch to kill amp from playing any audio. ")
		(comment 4 "POST_POT_IN_R/L becomes the input to the amp.")
		(comment 5 "MAX_VOL SET BY AMP")
	)
