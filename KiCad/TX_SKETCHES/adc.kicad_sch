		(company "Damian Muschamp")
		(comment 1 "PCM1808 stereo ADC: TRS line-in, I2S slave to ESP32.")
		(comment 2 "FMT low = I2S serial format. MD0/MD1 low = slave mode.")
		(comment 3 "VCC on +5V (analog), VDD on +3V3 (digital).")
		(comment 4 "Firmware uses 32-bit I2S slots; packs int16 for ESP-NOW.")
	)
