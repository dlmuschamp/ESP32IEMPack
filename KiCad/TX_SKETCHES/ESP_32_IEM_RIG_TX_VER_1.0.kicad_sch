	(text "TRS jack -> PCM1808 -> ESP32 captures I2S and streams audio packets to paired RX over ESP-NOW."
		(exclude_from_sim no)
		(at 96.266 39.37 0)
		(effects
			(font
				(size 0.889 0.889)
			)
		)
		(uuid "832171c3-30f3-42ca-b09d-48c9960d1af7")
	)
	(text "Passives: 0805 HandSolder pads. Update PCB from Schematic.\nANT1 U.FL pigtail. No display. ICs stay their real packages."
		(exclude_from_sim no)
		(at 18.796 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bf47873e-f752-472d-a402-804634affdb0")
	)
	(text "Sets 5V and 3V3 using LDO.\nPowered by a 10,000 mAh 5V/2.0A USB-C bank\n(identical bank type as the RX; each pack has its own).\nUSB-C 16 pin.\nSupports USB-C updates via UART."
		(exclude_from_sim no)
		(at 39.878 38.862 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "e1b4084b-9d81-4171-befe-072019be5c9d")
	)
	(text "PCM1808 I2S slave. MD0/MD1/FMT strapped low.\nESP32 is I2S master (see esp_tx sheet note).\n"
		(exclude_from_sim no)
		(at 159.766 38.354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
