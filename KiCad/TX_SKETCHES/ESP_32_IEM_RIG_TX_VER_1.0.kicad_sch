	(paper "A5")
	(title_block
		(title "ESP32U-WROOM Wireless IEM Transmitter")
		(date "2026-08-04")
		(rev "1.0.0")
		(company "Damian Muschamp")
		(comment 1 "Signal: TRS line-in -> PCM1808 ADC -> ESP32 I2S -> ESP-NOW to RX pack.")
		(comment 2 "PCM1808: I2S slave (MD0/MD1 low). FMT low = I2S serial format.")
		(comment 3 "Firmware: BCK=33 LRCK=32 DIN=35 SCK/MCLK=0 (IO0 shared with boot strap).")
		(comment 4 "USB-C UART flash via CP2102. Same 10k mAh bank as RX (separate pack).")
	)
