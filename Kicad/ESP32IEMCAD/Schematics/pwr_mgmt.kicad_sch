	(title_block
		(title "ESP32 Wireless IEM Rig Reciever")
		(date "2026-08-04")
		(rev "0.0.3")
		(company "damian m")
		(comment 1 "Data: ESP -> DAC -> AMP-> 3.5mm Jack.")
		(comment 2 "Connect to a USB-C power bank. Will provide power to the entire RX circuit.")
		(comment 3 "CC1, CC2 have a pull down resistor to GND to signify it is an Upstream Facing Port (UFP)")
		(comment 4 "Using a low dropout regulator to step from 5V to 3V3 for ESP, DAC, and Amp.")
		(comment 5 "UFP: https://medium.com/@leung.benson/usb-type-c-s-configuration-channel-31e08047677d")
	)
